# Optional local configuration. No keys are required for built-in feedback.
# WARNING: VITE_* values are embedded in the public browser bundle.
# Do not put private credentials in a public deployment. Use a backend
# proxy with server-side secrets before deploying authenticated integrations.

VITE_GITHUB_TOKEN=
VITE_GEMINI_API_KEY=
VITE_GROQ_API_KEY=
VITE_ANTHROPIC_API_KEY=

# Optional model overrides
VITE_GEMINI_MODEL=gemini-2.5-flash
VITE_GROQ_MODEL=llama-3.3-70b-versatile
VITE_ANTHROPIC_MODEL=claude-sonnet-4-20250514
