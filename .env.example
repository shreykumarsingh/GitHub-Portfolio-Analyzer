# ===============================================================
# GitHub Portfolio Analyzer - Environment Variables
# All variables are OPTIONAL. Copy this file to .env
# ===============================================================

# ---------------------------------------------------------------
# 1. FREE AI Options (Choose any one or leave blank for built-in)
# ---------------------------------------------------------------

# FREE OPTION A: Google Gemini Flash (Recommended - 100% Free, no credit card)
# Get your free key at: https://aistudio.google.com/app/apikey
VITE_GEMINI_API_KEY=

# FREE OPTION B: Groq Cloud (Ultra-fast LLaMA 3.3 70B - 100% Free tier)
# Get your free key at: https://console.groq.com/keys
VITE_GROQ_API_KEY=

# Option C: Anthropic Claude (Paid)
# https://console.anthropic.com/
VITE_ANTHROPIC_API_KEY=

# NOTE: If all AI keys are empty, the app automatically uses its
# built-in local analysis engine (100% free, instant, zero config).

# ---------------------------------------------------------------
# 2. GitHub Token (Free - Optional)
# ---------------------------------------------------------------
# Increases GitHub API rate limit from 60 req/hr to 5,000 req/hr.
# Get a free Personal Access Token (classic, no scopes needed):
# https://github.com/settings/tokens
VITE_GITHUB_TOKEN=
